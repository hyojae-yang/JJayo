  m_text: "\uC778\uAC8C\uC784\uC5D0\uC11C \uC8C4\uCE21 \uC0C1\uB2E8\uC5D0\uB294 \uD558\uB8E8\uC758
    \uAE38\uC774\uB97C \uB098\uD0C0\uB0B4\uB294 \uAC8C\uC774\uC9C0\uAC00 \uC788\uACE0
    \uC6B0\uCE21\uC0C1\uB2E8\uC5D0\uB294 \uB0A0\uC9DC\uAC00 \uD45C\uC2DC\uB429\uB2C8\uB2E4.\n\uD558\uB2E8\uC5D0\uB294
    \uC88C\uCE21\uC5D4 \uB098\uAC00\uAE30 \uBC84\uD2BC\uC774 \uC788\uACE0 \uC911\uC559
    \uC0C1\uB2E8\uC740 \uCC29\uC720\uAE30 \uC6A9\uB7C9,\uC911\uC559 \uC911\uB2E8\uC740
    \uBC14\uAD6C\uB2C8 \uC6A9\uB7C9,\uC911\uC559 \uD558\uB2E8\uC740 \uBCF4\uC720\uC911\uC778
